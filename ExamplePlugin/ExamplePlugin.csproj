<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\StreamDockSDK\StreamDockSDK.csproj"/>
        <ProjectReference Include="..\StreamDockSDK.ManifestBuilder\StreamDockSDK.ManifestBuilder.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Copy log4net.config from Assets to root output folder -->
        <Content Include="Assets\log4net.config">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>log4net.config</Link>
        </Content>
        
        <!-- Copy manifest.json from Assets to root output folder if it exists (has priority over autogeneration) -->
        <Content Include="Assets\manifest.json" Condition="Exists('Assets\manifest.json')">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>manifest.json</Link>
        </Content>
        
        <!-- Copy all other files from Assets folder recursively (excluding log4net.config and manifest.json) -->
        <Content Include="Assets\**\*" Exclude="Assets\log4net.config;Assets\manifest.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Import StreamDockSDK targets for automatic manifest generation -->
    <Import Project="..\StreamDockSDK\Build\StreamDockSDK.targets" Condition="Exists('..\StreamDockSDK\Build\StreamDockSDK.targets')" />

</Project>
